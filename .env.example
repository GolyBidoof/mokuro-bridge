# mokuro-bridge configuration - copy to .env and adapt, or export these.
# The server does NOT read .env automatically; either `set -a && source .env
# && set +a` before ./run.sh, or export the values in your launcher/shell.

# ── Server ─────────────────────────────────────────────────────────────
# Keep the default 127.0.0.1 - the bridge is unauthenticated, so loopback is
# the only access control it has.
#MOKURO_BRIDGE_HOST=127.0.0.1
#MOKURO_BRIDGE_PORT=62642   # 62642 spells "MANGA" on a phone keypad

# Origins allowed to POST from browser userscripts (comma separated).
# Default: * (any origin). The bridge is loopback-only and sends no cookies,
# so it is unauthenticated by design; this variable is the opt-in way to
# narrow it back to a list. Uncomment to allow only the viewers you use:
#CORS_ORIGINS=https://viewer.bookwalker.jp,https://viewer-trial.bookwalker.jp

# ── Paths ───────────────────────────────────────────────────────────────
# Scratch space for pages + OCR JSON while a volume is in progress.
#MOKURO_BRIDGE_WORK_DIR=/Users/you/mokuro-input

# Where finished <series>/<volume>.{cbz,mokuro,webp} land when not uploading.
#MOKURO_BRIDGE_OUTPUT_DIR=/Users/you/mokuro-bridge/output

# Base URL `mokuro-bridge-ocr` (the folder-OCR companion) uses to reach a
# running bridge. Match it to MOKURO_BRIDGE_HOST/PORT above.
#MOKURO_BRIDGE_URL=http://127.0.0.1:62642

# ── MEGA upload (optional - off by default) ─────────────────────────────
#MOKURO_BRIDGE_UPLOAD_DEFAULT=true        # finalize uploads unless told otherwise
                                         # (also accepts an account id: mega:work)
#MEGA_LIBRARY_ROOT=/Root/mokuro-reader
#MEGA_EMAIL=you@example.com               # credentials (alternative to
#MEGA_PASSWORD=super-secret               #  `python3 server.py --setup-upload mega`)
#MEGA_CREDS_FILE=/Users/you/.config/mokuro-bridge/credentials.env

# ── Extra accounts (optional) ───────────────────────────────────────────
# Every provider can hold several accounts: `python3 server.py --setup-upload
# mega --name work [--root /Root/other-library] [--label "Work"]` adds one,
# `--list-uploads` shows them, `--remove-upload mega:work` deletes one. The
# bare ids (mega/drive/onedrive) stay the default account; the extras are
# addressed as `<provider>:<name>`. Non-secret metadata lives in this
# directory (secrets stay in the keychain / their own 0600 files):
#MOKURO_BRIDGE_ACCOUNTS_DIR=/Users/you/.config/mokuro-bridge/accounts

# ── Google Drive upload (optional; needs pip install -r requirements-drive.txt)
# Run `python3 server.py --setup-upload drive` - it walks you through creating
# a free Google Cloud "Desktop app" OAuth client and pasting its Client ID +
# Client secret (Google requires the secret at token exchange; it is never
# stored). Optional overrides:
#DRIVE_ROOT_NAME=mokuro-reader            # library folder at My Drive root
#DRIVE_CREDS_FILE=/Users/you/.config/mokuro-bridge/drive_credentials.json
#DRIVE_CLIENT_ID=1234-....apps.googleusercontent.com   # skip the paste step
#DRIVE_CLIENT_SECRET=GOCSPX-....                         # ...and the secret
#DRIVE_CLIENT_SECRET_FILE=/Users/you/client_secret.json   # or a full client_secrets.json

# ── OneDrive upload (optional; needs pip install -r requirements-onedrive.txt)
#ONEDRIVE_CLIENT_ID=00000000-0000-0000-0000-000000000000   # Azure app (public client)
#ONEDRIVE_ROOT_NAME=mokuro-reader         # library folder at your OneDrive root
#ONEDRIVE_TOKEN_FILE=/Users/you/.config/mokuro-bridge/onedrive_token.json

# ── OCR engine ──────────────────────────────────────────────────────────
# Path to a mokuro checkout (optimized fork) instead of the pip package.
#MOKURO_REPO=/Users/you/mokuro
#OCR_CHUNK_SIZE=8
#OCR_IDLE_FLUSH_S=1.5
# Round-robin mixed-volume batches; set 0 for legacy FIFO/finalize priority.
#MOKURO_BRIDGE_OCR_FAIR_SCHEDULING=true
# Fraction of a mixed batch reserved for sessions waiting on finalize (0-1).
#MOKURO_BRIDGE_OCR_FINALIZE_PRIORITY=0.5
#MIN_PAGES_FOR_MEGA=10

# ── Page-fetch accelerator ─────────────────────────────────────────────
# Extra localhost ports the downloader can fetch pages through. Chrome allows 6
# concurrent connections per origin, and an origin includes the port, so each
# port here is worth 6 more sockets to the browser. 0 disables the feature.
#MOKURO_BRIDGE_FETCH_PORTS=48
#MOKURO_BRIDGE_FETCH_CONCURRENCY=0        # 0 = no cap on simultaneous fetches
#MOKURO_BRIDGE_FETCH_UPSTREAM=https://bw-bv-epubs.bookwalker.jp
# Comma-separated host patterns the accelerator may forward to. Empty/unset
# means "*", i.e. any public host: the real gate is the address check, which
# refuses loopback, private, link-local, multicast and reserved targets (so LAN
# hosts and 169.254.169.254 are blocked) but allows the public internet. Set it
# to pin the accelerator to specific CDNs.
#MOKURO_BRIDGE_FETCH_ALLOWED_HOSTS=bw-bv-epubs.bookwalker.jp

# ── Update check ────────────────────────────────────────────────────────
# The bridge asks the public GitHub releases API whether a newer version
# exists, and reports it in /health and via `--check-update`. Nothing is ever
# downloaded or installed automatically. Set 0 on an offline machine; a
# `--check-update` you run by hand still works then.
#MOKURO_BRIDGE_UPDATE_CHECK=true
#MOKURO_BRIDGE_UPDATE_TTL_S=21600          # reuse a result for 6 hours
#MOKURO_BRIDGE_UPDATE_TIMEOUT_S=5

# ── Dev only ────────────────────────────────────────────────────────────
#UVICORN_RELOAD=1
