cookies.json
yahoo_cookies.json
# Credential/env files
.env
*.env
!.env.example
# Aider/assistant history
.aider*

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# ── Node ─────────────────────────────────────────────────────────────────
node_modules/

# ── macOS ────────────────────────────────────────────────────────────────
.DS_Store

